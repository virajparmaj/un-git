{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "un-git",
  "version": "0.1.0",
  "identifier": "com.virajparmaj.un-git",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "un-git", "width": 1280, "height": 840, "minWidth": 900, "minHeight": 650, "backgroundColor": "#09090B" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "shortDescription": "Inspect Git attribution. Validate every change.",
    "category": "DeveloperTool",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": {"../../../workers/rewrite/": "rewrite/"},
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
